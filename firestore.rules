rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is owner
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is Admin (Role-based)
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if true; // ✅ Allow public read for "Total Members" stats
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isOwner(userId) || isAdmin(); // Allow Admin to update
    }

    // 2. Transactions
    match /transactions/{txId} {
      allow read: if true; // ✅ Allow public read for "Community Stats" aggregation
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // Allow fixes
      allow delete: if false; 
    }

    // 3. Public Data (Trash Types, Booths, Rewards)
    // - Everyone can read
    // - Only Admin can write
    match /trash_types/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /booths/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rewards/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
